@page
@model IndexModel

<!DOCTYPE html>
<html lang="en">

<!--CSS-->
<style>
    div.headOne
    {
        background-color: plum;
    }

    div.cold-coffee
    {
        color: blue;
    }

    div.hot-coffee
    {
        color: chocolate;
    }

    div.scolding-coffee
    {
        color: red;
    }

</style>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<div class = "headOne"> 
 <div class="text-center"> 
    <h1 class="display-4">Coffee Temperatures</h1>
   </div>
    <p>This program demonstrates conditional statements in C# Web Development</a>!</p>
    <br>

    <p>Coffee One is 50 degrees Fahrenheit</p>
    <br>
    <p>Coffee Two is 140 degrees Fahrenheit</p>
    <br>
    <p>Coffee Three is 200 degrees Fahrenheit</p>


@{
    ViewData["Title"] = "Coffee Temperatures";


int coffeeOne = 50; //Cold Coffee 
int coffeeTwo = 140; //Hot Coffee
int coffeeThree = 200; //Dangerous Coffee

//Conditional Statement
@if (coffeeOne <= 119)
{
    <div class="cold-coffee">
        <h1>Cold Coffee</h1>

    </div>
}
else if (coffeeOne >= 120 || coffeeOne <= 140)
{
    <div class="hot-coffee">
        <h1>Nice Cup of Coffee</h1>

    </div>
}

else if (coffeeOne >= 141)
{
    <div class="scolding-coffee">
        <h1>Danger! Scolding Hot Coffee</h1>

    </div>
}

else 
{
    <h2>Error Occured</h2>
}

@if (coffeeTwo <= 119)
{
    <div class="cold-coffee">
        <h1>Cold Coffee</h1>

    </div>
}
else if (coffeeTwo >= 120 && coffeeTwo <= 140)
{
    <div class="hot-coffee">
        <h1>Nice Cup of Coffee</h1>

    </div>
}

else if(coffeeTwo >= 141)
{
    <div class="scolding-coffee">
        <h1>Danger! Scolding Hot Coffee</h1>

    </div>
}

else 
{
    <h2>Error Occured</h2>
}

@if (coffeeThree <= 119)
{
    <div class="cold-coffee">
        <h1>Cold Coffee</h1>

    </div>
}
else if (coffeeThree >= 120 && coffeeThree <= 140)
{
    <div class="hot-coffee">
        <h1>Nice Cup of Coffee</h1>

    </div>
}

else if(coffeeThree >= 141)
{
    <div class="scolding-coffee">
        <h1>Danger! Scolding Hot Coffee</h1>

    </div>
}

else 
{
    <h2>Error Occured</h2>
}
}


<!-- Center Page -->
<body>

 <div class = "headOne"> 
 <div class="text-center"> 
   </div>
    
 </div> 
</body>
</html> 

