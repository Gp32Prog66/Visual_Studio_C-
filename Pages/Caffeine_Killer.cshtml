@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";

      //Declare Variables
      double @input, @numDrinks;
      
    Console.WriteLine("Enter the amount of caffeine in milligrams");
   @input = Convert.ToDouble(Console.ReadLine());
    
    //Calculations
    @numDrinks = 10000 / @input;
    
    @numDrinks = Math.Ceiling(@numDrinks);
    
    Console.WriteLine("Number of drinks that will kill you {0} ", @numDrinks);
}

<div class="text-center">
    <h1 class="display-4">Caffeine Killer</h1>
    <p>This program will calculate how many milligrams of caffeine it will take to kill you</a>!</p>

     

    <!-- User Input -->
    <label for="input">Enter the amount of caffeine in milligrams</label>
    <input type="text" id="input" name="input">
    <br>

    <button type="submit">Calculate</button>

