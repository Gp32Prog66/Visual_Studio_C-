@{
    ViewData["Title"] = "Caffeine Killer";


int coffeeOne = 50; //Cold Coffee 
int coffeeTwo = 140; //Hot Coffee
int coffeeThree = 200; //Dangerous Coffee

@if (coffeeOne <= 119)
{
    <div class="cold-coffee" style="color: blue;">
        <h1>Cold Coffee</h1>

    </div>
}
else if (coffeeOne >= 120 || coffeeOne <= 140)
{
    <div class="hot-coffee" style="color: chocolate;">
        <h1>Nice Cup of Coffee</h1>

    </div>
}

else if (coffeeOne >= 141)
{
    <div class="scolding-coffee" style="color: red;">
        <h1>Danger! Scolding Hot Coffee</h1>

    </div>
}

else 
{
    <h2>Error Occured</h2>
}

